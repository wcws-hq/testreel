{
  "name": "testreel",
  "version": "0.1.0",
  "description": "Paste a GitHub repo. Testreel runs it in a throwaway container, scores what it measured, and makes the YouTube video.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server/index.ts",
    "start": "bun src/server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "motion": "^14.2.0",
    "puppeteer-core": "^25.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
