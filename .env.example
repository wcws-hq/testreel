# Copy this file to .env (next to package.json) and fill it in. .env is ignored by git. Never commit it.
# A .env in the settings folder (default ~/.testreel) works too; values here win over it.

# ---- Model gateway (required) -------------------------------------------------------------
# Any server that speaks the OpenAI chat completions API: POST {GATEWAY_URL}/v1/chat/completions
# with "Authorization: Bearer <key>". Give the base URL without /v1 and without a trailing slash.
# Examples: https://api.openai.com, https://openrouter.ai/api, http://localhost:11434 (Ollama),
# or your own Claude gateway or proxy.
GATEWAY_URL=
GATEWAY_API_KEY=
# The model name the gateway expects. A strong model matters: it classifies repos, drives the browser
# tests and writes the scripts.
GATEWAY_MODEL=

# ---- YouTube upload (optional, only needed for the Upload button) -------------------------
# See docs/youtube.md.
YT_CLIENT_ID=
YT_CLIENT_SECRET=

# ---- GitHub (optional) ---------------------------------------------------------------------
# Raises the GitHub API limit from 60 to 5000 requests an hour. Without it Testreel uses the sign-in
# of the GitHub CLI (`gh auth token`) when that is installed. A token with no scopes is enough.
GITHUB_TOKEN=

# ---- Branding and voice (optional) ---------------------------------------------------------
CHANNEL_NAME=Testreel
KOKORO_VOICE_A=af_heart
KOKORO_VOICE_B=am_fenrir
KOKORO_SPEED=1

# ---- Paths and port (optional) -------------------------------------------------------------
# PORT=4173
# TESTREEL_SETTINGS=~/.testreel            voice venv, Kokoro models, YouTube sign-in token
# TESTREEL_DATA=                           where runs are stored (default: ~/Library/Application Support/Testreel on macOS)
# CHROME_PATH=                             Chrome or Chrome for Testing executable
# KOKORO_PYTHON=  KOKORO_MODEL=  KOKORO_VOICES=
